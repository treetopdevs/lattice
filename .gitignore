# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# JavaScript browser E2E dependencies.
/node_modules/
/output/playwright/
/output/flagship/
/output/liveops/
/output/browser_beam_carrier/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Local editor/session artifacts.
.cursorindexingignore
.expert/
.specstory/

# Local toolchain override (mise: defer Erlang/Elixir to asdf's OTP 28).
.mise.toml

# AtomVM Phase-0 spike: vendored prebuilt binaries (pinned via spike/atomvm/vendor/VERSIONS.sha256)
spike/atomvm/vendor/*.js
spike/atomvm/vendor/*.wasm
spike/atomvm/**/*.avm
spike/atomvm/AtomVM-src/
# AtomVM Phase-0 spike: throwaway build artifacts + fetched deps (keep harness + results)
spike/atomvm/hello/_build/
spike/atomvm/hello/deps/
spike/atomvm/beams/

# AtomVM tab build artifacts (regenerated by apps/lattice_tab/build_avm.sh; never committed)
apps/lattice_tab/.atomvm_build/
apps/lattice_tab/lattice_tab.avm
examples/atomvm_tab/*.avm
examples/atomvm_tab/AtomVM-web-*.js
examples/atomvm_tab/AtomVM-web-*.wasm
