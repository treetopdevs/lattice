[Unit]
Description=Treehouse relay encrypted backup to Spaces
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/treehouse-backup
# backup.sh makes up to four attempts, 30 minutes apart, each limited to one hour. This
# outer limit only stops a run that exceeds that plan. It must stay under the 12-hour
# interval between scheduled starts.
TimeoutStartSec=8h
