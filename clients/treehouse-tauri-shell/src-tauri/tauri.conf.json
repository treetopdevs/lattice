{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treehouse",
  "version": "0.1.0",
  "identifier": "dev.treetop.lattice.treehouse",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Treehouse",
        "width": 1100,
        "height": 780,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
