{
  "name": "@treetopdevs/treehouse-tauri-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "typecheck": "vue-tsc --noEmit",
