    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@tauri-apps/api": "2.11.1",
    "@treetopdevs/lattice-client": "file:../lattice-client",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "6.0.7",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vue-tsc": "3.3.6"
  }
}
