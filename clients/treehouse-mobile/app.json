{
  "expo": {
    "name": "Treehouse",
    "slug": "treehouse-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "treehouse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.treetopdevs.treehouse.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.treetopdevs.treehouse.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
