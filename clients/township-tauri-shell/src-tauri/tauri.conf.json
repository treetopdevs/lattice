{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Township",
  "version": "0.1.0",
  "identifier": "dev.treetop.lattice.township",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Township",
        "width": 1100,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["township"]
      },
      "mobile": [
        {
          "scheme": ["township"],
          "appLink": false
        }
      ]
    }
  }
}
