{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Township",
  "version": "0.1.0",
  "identifier": "dev.treetop.lattice.township",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Township",
        "width": 1100,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://localhost:5173 ws://localhost:5173 ws: wss:",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost http://localhost:5173 blob: data:",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "script-src": "'self' http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["township"]
      },
      "mobile": [
        {
          "scheme": ["township"],
          "appLink": false
        }
      ]
    }
  }
}
