    "tauri:android:release:browser-onboarding-grant:smoke": "tsx test/tauri_android_release_browser_onboarding_grant_probe.ts",
    "tauri:android:release:browser-onboarding-grant-state-exchange:smoke": "TOWNSHIP_RELEASE_ONBOARDING_GRANT_BUILD_SCRIPT=tauri:android:build:release:onboarding-grant-state-probe tsx test/tauri_android_release_browser_onboarding_grant_probe.ts",
