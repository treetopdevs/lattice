    "tauri:android:release:browser-onboarding-state-exchange:smoke": "TOWNSHIP_RELEASE_ONBOARDING_BUILD_SCRIPT=tauri:android:build:release:onboarding-state-probe tsx test/tauri_android_release_browser_onboarding_probe.ts",
