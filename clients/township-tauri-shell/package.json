{
  "name": "@treetopdevs/township-tauri-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../lattice-client run build",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build --bundles app",
    "tauri:build:dev-trace": "VITE_TOWNSHIP_DEV_TRACE=1 VITE_TOWNSHIP_AUTOSYNC_ON_MOUNT=0 tauri build --features township-dev-trace --bundles app",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "frontend:contract": "node --test test/frontend_shell.mjs",
    "native:contract": "tsx test/native_workflow.ts",
    "action:contract": "tsx test/township_actions.ts",
    "canonical:probe:contract": "tsx test/township_canonical_probe.ts",
    "release:transport:contract": "tsx test/township_release_transport_probe.ts",
    "release:beam:contract": "tsx test/township_release_beam_probe.ts",
    "release:sync:contract": "tsx test/township_release_sync_probe.ts",
    "release:author:contract": "tsx test/township_release_author_probe.ts",
    "release:pairing:contract": "tsx test/township_release_pairing_probe.ts",
    "release:onboarding:contract": "tsx test/township_release_onboarding_probe.ts",
    "mobile:strategy": "node --test test/mobile_secure_store_strategy.mjs",
    "mobile:tauri-readiness": "node --test test/tauri_mobile_readiness.mjs",
    "tauri:android:emulator:smoke": "tsx test/tauri_android_emulator_smoke.ts",
    "tauri:android:beam:smoke": "tsx test/tauri_android_beam_smoke.ts",
    "tauri:android:authoring:smoke": "tsx test/tauri_android_authoring_smoke.ts",
    "tauri:android:onboarding:smoke": "tsx test/tauri_android_onboarding_smoke.ts",
    "tauri:android:release:smoke": "tsx test/tauri_android_release_smoke.ts",
    "tauri:android:release:canonical:smoke": "tsx test/tauri_android_release_canonical_probe.ts",
    "tauri:android:release:transport:smoke": "tsx test/tauri_android_release_transport_probe.ts",
    "tauri:android:release:beam:smoke": "tsx test/tauri_android_release_beam_probe.ts",
    "tauri:android:release:sync:smoke": "tsx test/tauri_android_release_sync_probe.ts",
    "tauri:android:release:author:smoke": "tsx test/tauri_android_release_author_probe.ts",
    "tauri:android:release:pairing:smoke": "tsx test/tauri_android_release_pairing_probe.ts",
    "tauri:android:release:onboarding:smoke": "tsx test/tauri_android_release_onboarding_probe.ts",
    "tauri:android:release:convergence": "npm run tauri:android:build:release:sync-probe && npm run tauri:android:release:sync:smoke && npm run tauri:android:build:release:author-probe && npm run tauri:android:release:author:smoke && npm run tauri:android:build:release:pairing-probe && npm run tauri:android:release:pairing:smoke",
    "tauri:android:release:cleartext-diagnostic:smoke": "tsx test/tauri_android_release_cleartext_diagnostic_probe.ts",
    "app:convergence": "npm run action:contract && npm run sync:contract && npm run live:contract && npm run tauri:launch:smoke && npm run tauri:deep-link:smoke",
    "tauri:ios:init": "tauri ios init --ci --skip-targets-install",
    "tauri:android:init": "tauri android init --ci --skip-targets-install",
    "tauri:android:build:debug": "PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --debug --apk --ci",
    "tauri:android:build:release": "PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:transport-probe": "VITE_TOWNSHIP_RELEASE_TRANSPORT_PROBE_URLS=ws://127.0.0.1:43185/carrier,ws://10.0.2.2:43185/carrier PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:beam-probe": "VITE_TOWNSHIP_RELEASE_BEAM_PROBE_URL=ws://127.0.0.1:43190/carrier VITE_TOWNSHIP_RELEASE_BEAM_PROBE_LOCAL_REALM=resident VITE_TOWNSHIP_RELEASE_BEAM_PROBE_PEER_REALM=clerk VITE_TOWNSHIP_RELEASE_BEAM_PROBE_PEER_PUBKEY=Ze1W+4DnnK6aoJY5GiUoDVyZVhq5/PCL7UwQALXUQNk= VITE_TOWNSHIP_RELEASE_BEAM_PROBE_REPLICA='replica:matter:township-g1#root:QUB7owpVIsZn3IyoVLJbsFc5HLkozhi2PVBL5Lzhj3w' PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:sync-probe": "VITE_TOWNSHIP_RELEASE_SYNC_PROBE_URL=ws://127.0.0.1:43191/carrier VITE_TOWNSHIP_RELEASE_SYNC_PROBE_LOCAL_REALM=resident VITE_TOWNSHIP_RELEASE_SYNC_PROBE_PEER_REALM=clerk VITE_TOWNSHIP_RELEASE_SYNC_PROBE_PEER_PUBKEY=Ze1W+4DnnK6aoJY5GiUoDVyZVhq5/PCL7UwQALXUQNk= VITE_TOWNSHIP_RELEASE_SYNC_PROBE_REPLICA='replica:matter:township-g1#root:QUB7owpVIsZn3IyoVLJbsFc5HLkozhi2PVBL5Lzhj3w' VITE_TOWNSHIP_RELEASE_SYNC_PROBE_KEY_ID=township-release-sync-resident VITE_TOWNSHIP_RELEASE_SYNC_PROBE_STORAGE_NAMESPACE=township:release-sync-probe VITE_TOWNSHIP_RELEASE_SYNC_PROBE_TIMEOUT_MS=8000 VITE_TOWNSHIP_RELEASE_SYNC_PROBE_RETRY_DELAY_MS=500 PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:author-probe": "VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_URL=ws://127.0.0.1:43192/carrier VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_LOCAL_REALM=resident VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_PEER_REALM=clerk VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_PEER_PUBKEY=Ze1W+4DnnK6aoJY5GiUoDVyZVhq5/PCL7UwQALXUQNk= VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_REPLICA='replica:matter:township-g1#root:QUB7owpVIsZn3IyoVLJbsFc5HLkozhi2PVBL5Lzhj3w' VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_KEY_ID=township-release-author-resident VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_STORAGE_NAMESPACE=township:release-author-probe VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_GRANT_AUDIENCE_PUBKEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE= VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_POST_TEXT=release-probe-post VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_BAD_SUMMARY_TEXT=release-probe-unauthorized-summary VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_TIMEOUT_MS=12000 VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_RETRY_DELAY_MS=500 VITE_TOWNSHIP_RELEASE_AUTHOR_PROBE_PAUSE_AFTER_AUTHOR_MS=30000 PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:pairing-probe": "VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_LOCAL_REALM=resident VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_KEY_ID=township-release-pairing-resident VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_STORAGE_NAMESPACE=township:release-pairing-probe VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_ARM_STATE=release-pairing-state-103 VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_TIMEOUT_MS=60000 VITE_TOWNSHIP_RELEASE_PAIRING_PROBE_RETRY_DELAY_MS=500 PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:onboarding-probe": "VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_LOCAL_REALM=resident VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_KEY_ID=township-release-onboarding-resident VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_STORAGE_NAMESPACE=township:release-onboarding-probe VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_ARM_STATE=release-onboarding-state-106 VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_POST_TEXT=release-onboarding-post VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_BAD_SUMMARY_TEXT=release-onboarding-unauthorized-summary VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_TIMEOUT_MS=60000 VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_RETRY_DELAY_MS=500 VITE_TOWNSHIP_RELEASE_ONBOARDING_PROBE_PAUSE_AFTER_AUTHOR_MS=30000 PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci",
    "tauri:android:build:release:cleartext-diagnostic:transport-probe": "tmpdir=$(mktemp -d) && trap 'rm -rf \"$tmpdir\"' EXIT && VITE_TOWNSHIP_RELEASE_TRANSPORT_PROBE_URLS=ws://127.0.0.1:43185/carrier,ws://10.0.2.2:43185/carrier PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci && cp src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk \"$tmpdir/app-universal-release.apk\" && TOWNSHIP_ANDROID_RELEASE_CLEAR_TEXT_DIAGNOSTIC=1 VITE_TOWNSHIP_RELEASE_TRANSPORT_PROBE_URL=ws://127.0.0.1:43188/carrier PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --apk --ci && cp src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-cleartextdiag.apk && cp \"$tmpdir/app-universal-release.apk\" src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk",
    "tauri:android:build:debug:transport-probe": "VITE_TOWNSHIP_RELEASE_TRANSPORT_PROBE_URL=ws://127.0.0.1:43186/carrier PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --debug --apk --ci",
    "tauri:android:debug:transport:smoke": "tsx test/tauri_android_debug_transport_probe.ts",
    "peer:contract": "tsx test/township_carrier_peer.ts",
    "deeplink:contract": "tsx test/township_pairing_deeplink.ts",
    "deeplink:source:contract": "tsx test/township_pairing_deeplink_source.ts",
    "qr:contract": "tsx test/township_pairing_qr.ts",
    "qr:camera:contract": "tsx test/township_pairing_qr_camera.ts",
    "discovery:contract": "tsx test/township_pairing_discovery.ts",
    "tauri:deep-link:smoke": "tsx test/tauri_installed_deeplink_smoke.ts",
    "tauri:cold-deep-link:smoke": "tsx test/tauri_installed_cold_deeplink_smoke.ts",
    "sync:contract": "tsx test/township_sync.ts",
    "live:contract": "tsx test/township_live_peer.ts",
    "tauri:launch:smoke": "tsx test/tauri_launch_smoke.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@treetopdevs/lattice-client": "file:../lattice-client",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  },
  "license": "Apache-2.0"
}
