{
  "name": "@treetopdevs/township-tauri-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../lattice-client run build",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build --bundles app",
    "tauri:build:dev-trace": "VITE_TOWNSHIP_DEV_TRACE=1 VITE_TOWNSHIP_AUTOSYNC_ON_MOUNT=0 tauri build --features township-dev-trace --bundles app",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "frontend:contract": "node --test test/frontend_shell.mjs",
    "native:contract": "tsx test/native_workflow.ts",
    "action:contract": "tsx test/township_actions.ts",
    "action-intent:contract": "tsx test/township_action_intent.ts",
    "grant:fixture:contract": "tsx test/township_grant_handoff_fixture.ts",
    "canonical:probe:contract": "tsx test/township_canonical_probe.ts",
    "release:transport:contract": "tsx test/township_release_transport_probe.ts",
    "release:beam:contract": "tsx test/township_release_beam_probe.ts",
    "release:sync:contract": "tsx test/township_release_sync_probe.ts",
    "release:author:contract": "tsx test/township_release_author_probe.ts",
    "release:root-origination:contract": "tsx test/township_release_root_origination_probe.ts",
    "release:pairing:contract": "tsx test/township_release_pairing_probe.ts",
    "release:onboarding:contract": "tsx test/township_release_onboarding_probe.ts",
    "mobile:strategy": "node --test test/mobile_secure_store_strategy.mjs",
    "mobile:tauri-readiness": "node --test test/tauri_mobile_readiness.mjs",
    "tauri:android:emulator:smoke": "tsx test/tauri_android_emulator_smoke.ts",
    "tauri:android:beam:smoke": "tsx test/tauri_android_beam_smoke.ts",
    "tauri:android:authoring:smoke": "tsx test/tauri_android_authoring_smoke.ts",
    "tauri:android:onboarding:smoke": "tsx test/tauri_android_onboarding_smoke.ts",
    "tauri:android:release:smoke": "tsx test/tauri_android_release_smoke.ts",
    "tauri:android:release:canonical:smoke": "tsx test/tauri_android_release_canonical_probe.ts",
    "tauri:android:release:transport:smoke": "tsx test/tauri_android_release_transport_probe.ts",
    "tauri:android:release:beam:smoke": "tsx test/tauri_android_release_beam_probe.ts",
    "tauri:android:release:sync:smoke": "tsx test/tauri_android_release_sync_probe.ts",
    "tauri:android:release:author:smoke": "tsx test/tauri_android_release_author_probe.ts",
    "tauri:android:release:root-origination:smoke": "tsx test/tauri_android_release_root_origination_probe.ts",
