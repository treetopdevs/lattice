{
  "name": "@treetopdevs/township-tauri-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../lattice-client run build",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build --bundles app",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "frontend:contract": "node --test test/frontend_shell.mjs",
    "native:contract": "tsx test/native_workflow.ts",
    "action:contract": "tsx test/township_actions.ts",
    "mobile:strategy": "node --test test/mobile_secure_store_strategy.mjs",
    "mobile:tauri-readiness": "node --test test/tauri_mobile_readiness.mjs",
    "tauri:android:emulator:smoke": "tsx test/tauri_android_emulator_smoke.ts",
    "tauri:android:beam:smoke": "tsx test/tauri_android_beam_smoke.ts",
    "app:convergence": "npm run action:contract && npm run sync:contract && npm run live:contract && npm run tauri:launch:smoke && npm run tauri:deep-link:smoke",
    "tauri:ios:init": "tauri ios init --ci --skip-targets-install",
    "tauri:android:init": "tauri android init --ci --skip-targets-install",
    "tauri:android:build:debug": "PATH=/opt/homebrew/opt/rustup/bin:$PATH tauri android build --debug --apk --ci",
    "peer:contract": "tsx test/township_carrier_peer.ts",
    "deeplink:contract": "tsx test/township_pairing_deeplink.ts",
    "deeplink:source:contract": "tsx test/township_pairing_deeplink_source.ts",
    "qr:contract": "tsx test/township_pairing_qr.ts",
    "qr:camera:contract": "tsx test/township_pairing_qr_camera.ts",
    "discovery:contract": "tsx test/township_pairing_discovery.ts",
    "tauri:deep-link:smoke": "tsx test/tauri_installed_deeplink_smoke.ts",
    "sync:contract": "tsx test/township_sync.ts",
    "live:contract": "tsx test/township_live_peer.ts",
    "tauri:launch:smoke": "tsx test/tauri_launch_smoke.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@treetopdevs/lattice-client": "file:../lattice-client",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  },
  "license": "Apache-2.0"
}
